#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define MAIN 0
#define RNUM 1
#define LNUM 2
#define RSYM 3
#define LSYM 4
#define ADJT 5

&lt { quick_tap_ms = <180>; };
&mt { quick_tap_ms = <180>; };

/ {
    chosen {
        zmk,physical_layout = &dao_crkbd_layout;
        // zmk,physical_layout = &dao_full_layout;
    };
};

/ {
        behaviors {
            cmt: custom_mod_tap {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "tap-preferred";
                require-prior-idle-ms = <125>;
                quick-tap-ms = <200>;
                tapping-term-ms = <150>;
                bindings = <&kp>, <&kp>;
            };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "MAIN";
                        bindings = <
&kp LALT         &kp Q  &kp W  &kp E  &kp R    &kp T  &kp Y  &kp U  &kp I      &kp O    &kp P      &kp RALT
&cmt LSHFT ESC   &kp A  &kp S  &kp D  &kp F    &kp G  &kp H  &kp J  &kp K      &kp L    &kp SEMI   &cmt RSHIFT SINGLE_QUOTE
&cmt LCTRL CAPS  &kp Z  &kp X  &kp C  &kp V    &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH  &cmt RCTRL LG(SPACE)

    &cmt LGUI TAB  &lt LNUM SPACE  &mo LSYM    &mo RSYM  &lt RNUM RET  &cmt RGUI LC(B) 
                        >;
                };

                right_number_layer {
                        display-name = "RNUM";
                        bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp F6     &kp F7         &kp F8        &kp F9  &kp F10  &kp BSPC
&trans  &trans  &trans  &trans  &trans  &trans    &kp N6     &kp N7         &kp N8        &kp N9  &kp N0   &kp F11
&trans  &trans  &trans  &trans  &trans  &trans    &kp CARET  &kp AMPERSAND  &kp ASTERISK  &trans  &trans   &kp F12

                        &trans  &trans  &trans    &trans  &trans  &trans
                        >;
                };

                left_number_layer {
                        display-name = "LNUM";
                        bindings = <
&kp DEL  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5           &trans  &trans  &trans  &trans  &trans  &trans
&kp CAPS &kp N1   &kp N2   &kp N3   &kp N4   &kp N5           &trans  &trans  &trans  &trans  &trans  &trans
&kp INS  &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PERCENT      &trans  &trans  &trans  &trans  &trans  &trans

                             &trans  &trans  &trans           &trans  &trans  &trans
                        >;
                };

                right_symbol_layer {
                        display-name = "RSYM";
                        bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp LPAR       &kp RPAR        &kp PIPE &kp LEFT_BRACKET &kp RIGHT_BRACKET &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT       &kp DOWN        &kp UP   &kp RIGHT        &none             &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LEFT_BRACE &kp RIGHT_BRACE &kp LT   &kp GT           &kp BACKSLASH     &trans

                        &trans  &trans  &trans     &trans  &trans  &mo ADJT
                        >;
                };

                left_symbol_layer {
                        display-name = "LSYM";
                        bindings = <
&trans          &kp GRAVE &kp TILDE &none     &kp PLUS     &kp EQUAL  &trans  &trans  &trans  &trans  &trans  &trans
&trans          &kp EXCL  &kp HOME  &kp PG_UP &kp PG_DN    &kp END    &trans  &trans  &trans  &trans  &trans  &trans
&kp PRINTSCREEN &none     &none     &none     &kp UNDER    &kp MINUS  &trans  &trans  &trans  &trans  &trans  &trans

                               &mo ADJT  &trans  &trans    &trans  &trans  &trans
                        >;
                };

                adjust_layer {
                        display-name = "ADJT";
                        bindings = <
&bootloader &none        &none        &kp C_BRI_UP  &kp C_VOL_UP  &kp C_MUTE      &none        &none        &none        &none        &none        &bootloader
&bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4 &bt BT_SEL 3 &bt BT_SEL 2 &bt BT_SEL 1 &bt BT_SEL 0 &bt BT_CLR
&sys_reset  &none        &none        &kp C_BRI_DN  &kp C_VOL_DN  &none           &none        &none        &none        &none        &none        &sys_reset

                                                  &trans  &trans  &trans          &trans  &trans  &trans
                        >;
                };
        };
};
